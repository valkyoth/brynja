diff --git a/assurance/poly1305/examples/neon_owner.rs b/assurance/poly1305/examples/neon_owner.rs
new file mode 100644
index 0000000..d2042c5
--- /dev/null
+++ b/assurance/poly1305/examples/neon_owner.rs
@@ -0,0 +1,106 @@
+//! Public fixture data; this compares complete checked-key messages, not startup.
+#[cfg(all(
+    target_arch = "aarch64",
+    target_endian = "little",
+    target_feature = "neon",
+    any(target_os = "linux", target_os = "macos")
+))]
+use brynja_mac_poly1305::{OneTimeKey, neon::Neon};
+#[cfg(all(
+    target_arch = "aarch64",
+    target_endian = "little",
+    target_feature = "neon",
+    any(target_os = "linux", target_os = "macos")
+))]
+use std::{hint::black_box, time::Instant};
+
+#[cfg(all(
+    target_arch = "aarch64",
+    target_endian = "little",
+    target_feature = "neon",
+    any(target_os = "linux", target_os = "macos")
+))]
+fn record(cpu: Option<&mut Neon>, key: &[u8; 32], msg: &[u8], chunk: usize) -> [u8; 16] {
+    let mut storage = *key;
+    let one = OneTimeKey::new(&mut storage).unwrap();
+    if let Some(cpu) = cpu {
+        let mut mac = one.start_neon(cpu).unwrap();
+        for part in msg.chunks(chunk) {
+            mac.update(part).unwrap();
+        }
+        mac.finalize().unwrap()
+    } else {
+        let mut mac = one.start();
+        for part in msg.chunks(chunk) {
+            mac.update(part).unwrap();
+        }
+        mac.finalize()
+    }
+}
+
+#[cfg(not(all(
+    target_arch = "aarch64",
+    target_endian = "little",
+    target_feature = "neon",
+    any(target_os = "linux", target_os = "macos")
+)))]
+fn main() {
+    eprintln!("required NEON: unsupported target");
+    std::process::exit(2);
+}
+
+#[cfg(all(
+    target_arch = "aarch64",
+    target_endian = "little",
+    target_feature = "neon",
+    any(target_os = "linux", target_os = "macos")
+))]
+fn main() {
+    let mut cpu = Neon::probe().unwrap_or_else(|why| {
+        eprintln!("required NEON: {why:?}");
+        std::process::exit(2)
+    });
+    let bench = std::env::args().nth(1).as_deref() == Some("--bench");
+    let key = std::array::from_fn(|i| (i as u8).wrapping_mul(31));
+    if bench {
+        println!("bytes,chunk,pair,records,portable_ns,owner_ns");
+    }
+    for (size, chunk) in [16, 31, 32, 33, 256, 1023, 1024, 1025, 1500, 4096, 16384]
+        .map(|n| (n, n))
+        .into_iter()
+        .chain([(16384, 1500), (16384, 17)])
+    {
+        let msg: Vec<_> = (0..size).map(|i| (i as u8).wrapping_mul(117)).collect();
+        assert_eq!(
+            record(Some(&mut cpu), &key, &msg, chunk),
+            record(None, &key, &msg, chunk)
+        );
+        if !bench {
+            continue;
+        }
+        let reps = 524288 / size;
+        let mut batch = |native: bool| {
+            let now = Instant::now();
+            for _ in 0..reps {
+                black_box(record(
+                    if native { Some(&mut cpu) } else { None },
+                    black_box(&key),
+                    black_box(&msg),
+                    black_box(chunk),
+                ));
+            }
+            now.elapsed().as_nanos()
+        };
+        batch(false);
+        batch(true);
+        for pair in 0..12 {
+            let (p, v) = if pair % 2 == 0 {
+                (batch(false), batch(true))
+            } else {
+                let v = batch(true);
+                (batch(false), v)
+            };
+            println!("{size},{chunk},{pair},{reps},{p},{v}");
+        }
+    }
+}
diff --git a/assurance/poly1305/tests/neon_vectors.rs b/assurance/poly1305/tests/neon_vectors.rs
new file mode 100644
index 0000000..bc1650a
--- /dev/null
+++ b/assurance/poly1305/tests/neon_vectors.rs
@@ -0,0 +1,88 @@
+#![cfg(all(
+    target_arch = "aarch64",
+    target_endian = "little",
+    target_feature = "neon",
+    any(target_os = "linux", target_os = "macos")
+))]
+
+use brynja_mac_poly1305::{Error, OneTimeKey, neon::Neon};
+
+fn decode(s: &str) -> Vec<u8> {
+    let (pairs, rest) = s.as_bytes().as_chunks::<2>();
+    assert!(rest.is_empty());
+    pairs
+        .iter()
+        .map(|p| u8::from_str_radix(std::str::from_utf8(p).unwrap(), 16).unwrap())
+        .collect()
+}
+
+fn check(cpu: &mut Neon, key: [u8; 32], msg: &[u8], tag: [u8; 16], chunks: &[usize]) {
+    for &chunk in chunks {
+        let mut storage = key;
+        let mut mac = OneTimeKey::from_rfc8439_key(&mut storage)
+            .start_neon(cpu)
+            .unwrap();
+        for bytes in msg.chunks(chunk) {
+            mac.update(bytes).unwrap();
+        }
+        assert_eq!(mac.finalize().unwrap(), tag);
+        assert_eq!(storage, [0; 32]);
+    }
+    for i in 0..=16 {
+        let mut storage = key;
+        let mut mac = OneTimeKey::from_rfc8439_key(&mut storage)
+            .start_neon(cpu)
+            .unwrap();
+        mac.update(msg).unwrap();
+        let mut t = tag;
+        if let Some(b) = t.get_mut(i) {
+            *b ^= 1;
+        }
+        assert_eq!(
+            mac.verify(&t),
+            if i == 16 {
+                Ok(())
+            } else {
+                Err(Error::Authentication)
+            }
+        );
+        assert_eq!(storage, [0; 32]);
+    }
+}
+
+#[test]
+fn rfc_and_partitioned_long_updates() {
+    let mut cpu = Neon::probe().unwrap();
+    let records = include_str!("../../../crates/brynja-mac-poly1305/tests/data/rfc8439.tsv");
+    assert_eq!(records.lines().count(), 12);
+    for row in records.lines() {
+        let f: Vec<_> = row.split('\t').collect();
+        check(
+            &mut cpu,
+            decode(f[1]).try_into().unwrap(),
+            &decode(f[2]),
+            decode(f[3]).try_into().unwrap(),
+            &[1, 16, 17, 1024, 1500],
+        );
+    }
+    for seed in [0u8, 1, 31, 127, 255] {
+        let key = std::array::from_fn(|i| seed.wrapping_add(i as u8).wrapping_mul(19));
+        for size in [
+            63, 64, 65, 1023, 1024, 1025, 1039, 1040, 1500, 2049, 3000, 4096, 16384,
+        ] {
+            let msg: Vec<_> = (0..size)
+                .map(|i| seed.wrapping_add(i as u8) ^ ((i >> 8) as u8))
+                .collect();
+            let mut storage = key;
+            let mut mac = OneTimeKey::new(&mut storage).unwrap().start();
+            mac.update(&msg).unwrap();
+            check(
+                &mut cpu,
+                key,
+                &msg,
+                mac.finalize(),
+                &[1, 17, 63, 1023, 1024, 1025, 1500, size],
+            );
+        }
+    }
+}
