new file mode 100644
index 0000000..a3e44e5
--- /dev/null
+++ b/crates/brynja-crypto-cpu/src/poly1305_rvv.rs
@@ -0,0 +1,83 @@
+//! Explicit Linux RV64 Poly1305 execution; no automatic portable fallback.
+#![allow(unsafe_code)]
+
+use core::{hint::black_box, marker::PhantomData};
+mod kernel;
+
+/// Host lacks usable RVV, or this handle failed startup or was interrupted.
+#[derive(Debug, PartialEq, Eq, Clone, Copy)]
+pub enum Error {
+    /// No RVV support advertised by the process environment.
+    Unavailable,
+    /// Terminal for this handle.
+    Quarantined,
+}
+
+/// Thread-local required-native capability. The OS must keep the advertised
+/// ISA usable on every CPU where this thread runs. This does not pin a CPU.
+pub struct Rvv {
+    ready: bool,
+    local: PhantomData<*mut ()>,
+}
+
+impl Rvv {
+    /// Detect RVV and check two consecutive four-block groups against a
+    /// fixed, independently computed answer before admitting caller data.
+    pub fn probe() -> Result<Self, Error> {
+        unsafe extern "C" {
+            fn getauxval(kind: core::ffi::c_ulong) -> core::ffi::c_ulong;
+        }
+        // SAFETY: numeric AT_HWCAP query. A missing value denies V.
+        if unsafe { getauxval(16) } & (1 << (b'V' - b'A')) == 0 {
+            return Err(Error::Unavailable);
+        }
+        let mut owner = Self {
+            ready: true,
+            local: PhantomData,
+        };
+        let r = 0x0f0e_0d0c_0b0a_0908_0706_0504_0302_0100_u128.to_le_bytes();
+        let mut h = [7_u64, 0, 0, 0, 0].map(u64::to_le_bytes);
+        let mut next = 0_u8;
+        let blocks = [[(); 64]; 2].map(|row| {
+            row.map(|()| {
+                let byte = next;
+                next = next.wrapping_add(1);
+                byte
+            })
+        });
+        owner.absorb_groups(black_box(&mut h), black_box(&r), black_box(&blocks))?;
+        if h.map(u64::from_le_bytes) != [62060317, 5262367, 22716242, 12841259, 60432388] {
+            return Err(Error::Quarantined);
+        }
+        Ok(owner)
+    }
+
+    /// Whether this handle permits a new message, update, or finish.
+    pub fn check(&self) -> Result<(), Error> {
+        if self.ready {
+            Ok(())
+        } else {
+            Err(Error::Quarantined)
+        }
+    }
+
+    /// Low-level full groups only, without finalization. Each accumulator
+    /// slot is a little-endian radix-2^26 limb; unused high bits are ignored.
+    /// The raw multiplier is clamped here, never its powers. The caller owns
+    /// its buffers. Prefer the one-time-key API in the MAC crate.
+    #[doc(hidden)]
+    pub fn absorb_groups(
+        &mut self,
+        acc: &mut [[u8; 8]; 5],
+        r: &[u8; 16],
+        blocks: &[[u8; 64]],
+    ) -> Result<(), Error> {
+        self.check()?;
+        self.ready = false;
+        // SAFETY: probe is the sole constructor and checked host RVV before
+        // running even the startup test. No raw pointers cross the boundary.
+        *acc = unsafe { kernel::absorb(acc, r, blocks) };
+        self.ready = true;
+        Ok(())
+    }
+}
diff --git a/crates/brynja-crypto-cpu/src/poly1305_rvv/columns.S b/crates/brynja-crypto-cpu/src/poly1305_rvv/columns.S
new file mode 100644
index 0000000..5c4d6eb
--- /dev/null
+++ b/crates/brynja-crypto-cpu/src/poly1305_rvv/columns.S
@@ -0,0 +1,44 @@
+// Streaming owner candidate; standard scalar ABI, Linux RV64 with full V.
+// a0 = 5 x 4 u32 message limbs; a1 = 9 x 4 u32 weights; a2 = 5 u64 sums.
+.text
+.option push
+.option arch, +v
+.p2align 2
+.global brynja_owner_poly1305_rvv_columns
+.hidden brynja_owner_poly1305_rvv_columns
+.type brynja_owner_poly1305_rvv_columns,@function
+brynja_owner_poly1305_rvv_columns:
+    vsetivli zero, 4, e32, m1, ta, ma
+    .irp r,0,1,2,3,4
+        vle32.v v\r, (a0)
+        addi a0, a0, 16
+    .endr
+    .irp r,5,6,7,8,9,10,11,12,13
+        vle32.v v\r, (a1)
+        addi a1, a1, 16
+    .endr
+    .macro column dest,a,b,c,d,e
+        vwmulu.vv \dest,v0,\a
+        vwmaccu.vv \dest,v1,\b
+        vwmaccu.vv \dest,v2,\c
+        vwmaccu.vv \dest,v3,\d
+        vwmaccu.vv \dest,v4,\e
+    .endm
+    // v5..9 contain r,s,t,u,v; v10..13 contain 5s,5t,5u,5v.
+    column v16,v5,v13,v12,v11,v10
+    column v18,v6,v5,v13,v12,v11
+    column v20,v7,v6,v5,v13,v12
+    column v22,v8,v7,v6,v5,v13
+    column v24,v9,v8,v7,v6,v5
+    .purgem column
+    vsetivli zero, 4, e64, m2, ta, ma
+    vmv.s.x v28, zero
+    .irp r,16,18,20,22,24
+        vredsum.vs v30, v\r, v28
+        vmv.x.s t0, v30
+        sd t0, 0(a2)
+        addi a2, a2, 8
+    .endr
+    ret
+.size brynja_owner_poly1305_rvv_columns, .-brynja_owner_poly1305_rvv_columns
+.option pop
diff --git a/crates/brynja-crypto-cpu/src/poly1305_rvv/kernel.rs b/crates/brynja-crypto-cpu/src/poly1305_rvv/kernel.rs
new file mode 100644
index 0000000..599d462
--- /dev/null
+++ b/crates/brynja-crypto-cpu/src/poly1305_rvv/kernel.rs
@@ -0,0 +1,142 @@
+//! Four consecutive full blocks, in radix 2^26 modulo 2^130-5.
+use brynja_core::clear_owned_region;
+core::arch::global_asm!(include_str!("columns.S"), options(raw));
+
+type F = [u64; 5];
+const MASK: u64 = (1 << 26) - 1;
+
+fn limbs(mut n: u128) -> F {
+    core::array::from_fn(|_| {
+        let [a, b, c, d, ..] = n.to_le_bytes();
+        n >>= 26;
+        u64::from(u32::from_le_bytes([a, b, c, d])) & MASK
+    })
+}
+
+fn reduce(mut x: F) -> F {
+    // Each column (even after summing four lanes) is below 200 * 2^52.
+    // Fold at bit 130; after the first fold only limb 0 can exceed MASK.
+    for _ in 0..3 {
+        let mut carry = 0;
+        for word in &mut x {
+            let n = word.wrapping_add(carry);
+            *word = n & MASK;
+            carry = n >> 26;
+        }
+        x[0] = x[0].wrapping_add(carry.wrapping_mul(5));
+    }
+    x
+}
+
+fn product(a: F, [r, s, t, u, v]: F) -> F {
+    let [s5, t5, u5, v5] = [s, t, u, v].map(|x| x.wrapping_mul(5));
+    reduce(
+        [
+            [r, v5, u5, t5, s5],
+            [s, r, v5, u5, t5],
+            [t, s, r, v5, u5],
+            [u, t, s, r, v5],
+            [v, u, t, s, r],
+        ]
+        .map(|col| {
+            a.into_iter()
+                .zip(col)
+                .fold(0u64, |n, (x, y)| n.wrapping_add(x.wrapping_mul(y)))
+        }),
+    )
+}
+
+struct Scratch<const N: usize, const M: usize>([[[u8; 8]; M]; N]);
+impl<const N: usize, const M: usize> Drop for Scratch<N, M> {
+    fn drop(&mut self) {
+        let _ = clear_owned_region(self.0.as_flattened_mut().as_flattened_mut());
+    }
+}
+
+type Weights = [[u32; 4]; 9];
+
+struct Table<'a>(&'a mut Weights);
+impl Drop for Table<'_> {
+    fn drop(&mut self) {
+        // SAFETY: a contiguous initialized u32 array, exclusively borrowed;
+        // clearing every byte leaves a valid value.
+        let bytes = unsafe {
+            core::slice::from_raw_parts_mut(
+                core::ptr::from_mut(self.0).cast::<u8>(),
+                core::mem::size_of::<Weights>(),
+            )
+        };
+        let _ = clear_owned_region(bytes);
+    }
+}
+
+// SAFETY: caller admits Linux HWCAP V and maintains usable ISA through use.
+pub(super) unsafe fn absorb(
+    acc: &[[u8; 8]; 5],
+    raw: &[u8; 16],
+    blocks: &[[u8; 64]],
+) -> [[u8; 8]; 5] {
+    let mut h = acc.map(|v| u64::from_le_bytes(v) & MASK);
+    let r = limbs(u128::from_le_bytes(*raw) & 0x0fff_fffc_0fff_fffc_0fff_fffc_0fff_ffff);
+    let mut powers = Scratch([[[0; 8]; 5]; 4]);
+    let [r4, r3, r2, r1] = &mut powers.0;
+    *r1 = r.map(u64::to_le_bytes);
+    *r2 = product(r, r).map(u64::to_le_bytes);
+    *r3 = product(r2.map(u64::from_le_bytes), r).map(u64::to_le_bytes);
+    *r4 = product(r2.map(u64::from_le_bytes), r2.map(u64::from_le_bytes)).map(u64::to_le_bytes);
+    let mut storage = [[0; 4]; 9];
+    let table = Table(&mut storage);
+    for (i, row) in table.0.iter_mut().enumerate() {
+        for (out, p) in row.iter_mut().zip(&powers.0) {
+            let v = u64::from_le_bytes(p[if i < 5 { i } else { i - 4 }]);
+            *out = (if i < 5 { v } else { v * 5 }) as u32; // <5*2^26
+        }
+    }
+    drop(powers);
+    for block in blocks {
+        let [a, b, c, d] = block.as_chunks::<16>().0 else {
+            unreachable!("four full blocks")
+        };
+        let mut msg = [a, b, c, d].map(|b| {
+            let mut m = limbs(u128::from_le_bytes(*b));
+            m[4] |= 1 << 24;
+            m
+        });
+        for (v, x) in msg[0].iter_mut().zip(h) {
+            *v += x;
+        }
+        let words: [[u32; 4]; 5] = core::array::from_fn(|i| msg.each_ref().map(|m| m[i] as u32));
+        let mut sum = [0u64; 5];
+        unsafe extern "C" {
+            fn brynja_owner_poly1305_rvv_columns(
+                words: *const [[u32; 4]; 5],
+                weights: *const Weights,
+                sum: *mut [u64; 5],
+            );
+        }
+        // SAFETY: see admission above. Full V supports VL=4 at e32/m1 and
+        // e64/m2. All input rows are aligned and initialized. The five u64
+        // stores stay within the separate, exclusive sum; columns <200*2^52.
+        unsafe {
+            brynja_owner_poly1305_rvv_columns(&words, table.0, &mut sum);
+        }
+        h = reduce(sum);
+    }
+    h.map(u64::to_le_bytes)
+}
+
+#[cfg(test)]
+#[test]
+fn weights_cleared_on_return_and_unwind() {
+    for stop in [false, true] {
+        let mut weights = [[u32::MAX; 4]; 9];
+        let outcome = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _table = Table(&mut weights);
+            if stop {
+                std::panic::resume_unwind(std::boxed::Box::new(()));
+            }
+        }));
+        assert_eq!(outcome.is_err(), stop);
+        assert_eq!(weights, [[0; 4]; 9]);
+    }
+}
