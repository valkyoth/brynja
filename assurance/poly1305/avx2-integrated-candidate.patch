@@ -0,0 +1,79 @@
+//! Explicit Linux x86-64 Poly1305 execution; no automatic portable fallback.
+#![allow(unsafe_code)]
+
+use core::{hint::black_box, marker::PhantomData};
+mod kernel;
+
+/// Host lacks usable AVX2, or this handle failed startup or was interrupted.
+#[derive(Debug, PartialEq, Eq, Clone, Copy)]
+pub enum Error {
+    /// No AVX2 support advertised by the process environment.
+    Unavailable,
+    /// Terminal for this handle.
+    Quarantined,
+}
+
+/// Thread-local required-native capability. The OS must keep the advertised
+/// ISA usable on every CPU where this thread runs. This does not pin a CPU.
+pub struct Avx2 {
+    ready: bool,
+    local: PhantomData<*mut ()>,
+}
+
+impl Avx2 {
+    /// Detect AVX2 and check two consecutive four-block groups against a
+    /// fixed, independently computed answer before admitting caller data.
+    pub fn probe() -> Result<Self, Error> {
+        if !std::is_x86_feature_detected!("avx2") {
+            return Err(Error::Unavailable);
+        }
+        let mut owner = Self {
+            ready: true,
+            local: PhantomData,
+        };
+        let r = 0x0f0e_0d0c_0b0a_0908_0706_0504_0302_0100_u128.to_le_bytes();
+        let mut h = [7_u64, 0, 0, 0, 0].map(u64::to_le_bytes);
+        let mut next = 0_u8;
+        let blocks = [[(); 64]; 2].map(|row| {
+            row.map(|()| {
+                let byte = next;
+                next = next.wrapping_add(1);
+                byte
+            })
+        });
+        owner.absorb_groups(black_box(&mut h), black_box(&r), black_box(&blocks))?;
+        if h.map(u64::from_le_bytes) != [62060317, 5262367, 22716242, 12841259, 60432388] {
+            return Err(Error::Quarantined);
+        }
+        Ok(owner)
+    }
+
+    /// Whether this handle permits a new message, update, or finish.
+    pub fn check(&self) -> Result<(), Error> {
+        if self.ready {
+            Ok(())
+        } else {
+            Err(Error::Quarantined)
+        }
+    }
+
+    /// Low-level full groups only, without finalization. Each accumulator
+    /// slot is a little-endian radix-2^26 limb; unused high bits are ignored.
+    /// The raw multiplier is clamped here, never its powers. The caller owns
+    /// its buffers. Prefer the one-time-key API in the MAC crate.
+    #[doc(hidden)]
+    pub fn absorb_groups(
+        &mut self,
+        acc: &mut [[u8; 8]; 5],
+        r: &[u8; 16],
+        blocks: &[[u8; 64]],
+    ) -> Result<(), Error> {
+        self.check()?;
+        self.ready = false;
+        // SAFETY: probe is the sole constructor and checked host AVX2 before
+        // running even the startup test. No raw pointers cross the boundary.
+        *acc = unsafe { kernel::absorb(acc, r, blocks) };
+        self.ready = true;
+        Ok(())
+    }
+}
diff --git a/crates/brynja-crypto-cpu/src/poly1305_avx2/kernel.rs b/crates/brynja-crypto-cpu/src/poly1305_avx2/kernel.rs
new file mode 100644
index 00000000..ceacc5d1
--- /dev/null
+++ b/crates/brynja-crypto-cpu/src/poly1305_avx2/kernel.rs
@@ -0,0 +1,137 @@
+//! Four consecutive full blocks, in radix 2^26 modulo 2^130-5.
+use brynja_core::clear_owned_region;
+use core::arch::x86_64::*;
+
+type F = [u64; 5];
+const MASK: u64 = (1 << 26) - 1;
+
+fn limbs(mut n: u128) -> F {
+    core::array::from_fn(|_| {
+        let [a, b, c, d, ..] = n.to_le_bytes();
+        n >>= 26;
+        u64::from(u32::from_le_bytes([a, b, c, d])) & MASK
+    })
+}
+
+fn reduce(mut x: F) -> F {
+    // Each column (even after summing four lanes) is below 200 * 2^52.
+    // Fold at bit 130; after the first fold only limb 0 can exceed MASK.
+    for _ in 0..3 {
+        let mut carry = 0;
+        for word in &mut x {
+            let n = word.wrapping_add(carry);
+            *word = n & MASK;
+            carry = n >> 26;
+        }
+        x[0] = x[0].wrapping_add(carry.wrapping_mul(5));
+    }
+    x
+}
+
+fn product(a: F, [r, s, t, u, v]: F) -> F {
+    let [s5, t5, u5, v5] = [s, t, u, v].map(|x| x.wrapping_mul(5));
+    reduce(
+        [
+            [r, v5, u5, t5, s5],
+            [s, r, v5, u5, t5],
+            [t, s, r, v5, u5],
+            [u, t, s, r, v5],
+            [v, u, t, s, r],
+        ]
+        .map(|col| {
+            a.into_iter()
+                .zip(col)
+                .fold(0u64, |n, (x, y)| n.wrapping_add(x.wrapping_mul(y)))
+        }),
+    )
+}
+
+struct Scratch<const N: usize, const M: usize>([[[u8; 8]; M]; N]);
+impl<const N: usize, const M: usize> Drop for Scratch<N, M> {
+    fn drop(&mut self) {
+        let _ = clear_owned_region(self.0.as_flattened_mut().as_flattened_mut());
+    }
+}
+
+#[target_feature(enable = "avx2")]
+fn pack(bytes: [[u8; 8]; 4]) -> __m256i {
+    let [a, b, c, d] = bytes.map(i64::from_le_bytes);
+    _mm256_set_epi64x(d, c, b, a)
+}
+
+#[target_feature(enable = "avx2")]
+#[inline(never)]
+fn group(h: F, block: &[u8; 64], table: &Scratch<9, 4>) -> F {
+    let [a, b, c, d] = block.as_chunks::<16>().0 else {
+        unreachable!("64 bytes = four blocks")
+    };
+    let [mut first, b, c, d] = [a, b, c, d].map(|m| {
+        let mut words = limbs(u128::from_le_bytes(*m));
+        words[4] |= 1 << 24;
+        words
+    });
+    for (x, y) in first.iter_mut().zip(h) {
+        *x = x.wrapping_add(y);
+    }
+    let mut words = [_mm256_setzero_si256(); 5];
+    for ((((out, a), b), c), d) in words.iter_mut().zip(first).zip(b).zip(c).zip(d) {
+        *out = pack([a, b, c, d].map(u64::to_le_bytes));
+    }
+    let [r, s, t, u, v, s5, t5, u5, v5] = table.0.map(|w| pack(w));
+    reduce(
+        [
+            [r, v5, u5, t5, s5],
+            [s, r, v5, u5, t5],
+            [t, s, r, v5, u5],
+            [u, t, s, r, v5],
+            [v, u, t, s, r],
+        ]
+        .map(|col| {
+            let sum = words
+                .into_iter()
+                .zip(col)
+                .fold(_mm256_setzero_si256(), |acc, (x, y)| {
+                    _mm256_add_epi64(acc, _mm256_mul_epu32(x, y))
+                });
+            [
+                _mm256_extract_epi64::<0>(sum),
+                _mm256_extract_epi64::<1>(sum),
+                _mm256_extract_epi64::<2>(sum),
+                _mm256_extract_epi64::<3>(sum),
+            ]
+            .into_iter()
+            .fold(0u64, |n, x| n.wrapping_add(x.cast_unsigned()))
+        }),
+    )
+}
+
+#[target_feature(enable = "avx2")]
+pub(super) fn absorb(acc: &[[u8; 8]; 5], raw: &[u8; 16], blocks: &[[u8; 64]]) -> [[u8; 8]; 5] {
+    let mut h = acc.map(|v| u64::from_le_bytes(v) & MASK);
+    let r = limbs(u128::from_le_bytes(*raw) & 0x0fff_fffc_0fff_fffc_0fff_fffc_0fff_ffff);
+    let mut powers = Scratch([[[0; 8]; 5]; 4]);
+    let [r4, r3, r2, r1] = &mut powers.0;
+    *r1 = r.map(u64::to_le_bytes);
+    *r2 = product(r, r).map(u64::to_le_bytes);
+    *r3 = product(r2.map(u64::from_le_bytes), r).map(u64::to_le_bytes);
+    *r4 = product(r2.map(u64::from_le_bytes), r2.map(u64::from_le_bytes)).map(u64::to_le_bytes);
+    let mut table = Scratch([[[0; 8]; 4]; 9]);
+    let (base, fives) = table.0.split_at_mut(5);
+    for ((((slot, a), b), c), d) in base
+        .iter_mut()
+        .zip(r4.iter())
+        .zip(r3.iter())
+        .zip(r2.iter())
+        .zip(r1.iter())
+    {
+        *slot = [*a, *b, *c, *d];
+    }
+    for (dst, src) in fives.iter_mut().zip(base.iter().skip(1)) {
+        *dst = src.map(|x| u64::from_le_bytes(x).wrapping_mul(5).to_le_bytes());
+    }
+    drop(powers);
+    for block in blocks {
+        h = group(h, block, &table);
+    }
+    h.map(u64::to_le_bytes)
+}
